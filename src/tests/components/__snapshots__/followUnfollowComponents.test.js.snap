exports[`follower click should click on a follower 1`] = `
<div
  className="modal-dialog"
  role="document"
>
  <div
    className="modal-content"
  >
    <div
      className="modal-header"
    >
      <h5
        className="modal-title"
      >
        My Followers
      </h5>
      <button
        aria-label="Close"
        className="close"
        data-dismiss="modal"
        type="button"
      >
        <span
          aria-hidden="true"
        >
          ×
        </span>
      </button>
    </div>
    <div
      className="modal-body"
    >
      <div
        className="row"
        id="follower"
        onClick={[Function]}
      >
        <button
          className="col col-lg-3 "
          style={
            {
              "border": "none",
            }
          }
        >
          <img
            alt="profile"
            className="profile-page"
            src="https://cdn.pixabay.com/photo/2013/07/13/10/07/man-156584__340.png"
          />
        </button>
        <div
          className="col col-lg-9"
        >
          <h5 />
          <p />
        </div>
        <br />
      </div>
    </div>
    <div
      class="modal-footer"
    />
  </div>
</div>
`;

