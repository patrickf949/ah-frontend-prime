// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`passwordResetEmailLink  should render without fail 1`] = `
<div
  className="container mt-5"
>
  <div
    className="row"
  >
    <div
      className="col col-lg-3 col-sm-auto"
    />
    <div
      className="col col-lg-6  col-md-auto col-sm-auto password-reset-container"
    >
      <h2>
        Password Reset
      </h2>
      <p>
        Enter your Author's have the email address that you used to register. We'll send you an email with a link to reset your password.
      </p>
      <form
        method="POST"
        onSubmit={[MockFunction]}
      >
        <ForwardRef(Grid)
          spacing={2.25}
        >
          <ForwardRef(TextField)
            error={false}
            helperText=" "
            id="email"
            label="Email"
            name="email"
            onChange={[MockFunction]}
            required={true}
            type="email"
            value=""
          />
          <ForwardRef(Button)
            type="submit"
          >
            Send link
            <lt
              ariaLabel="password-reset-email-loading"
              color="#003153"
              height="24"
              width="48"
            />
          </ForwardRef(Button)>
        </ForwardRef(Grid)>
      </form>
    </div>
    <div
      className="col col-lg-3"
    />
  </div>
</div>
`;

